# Example env for Ethereum mainnet deploy
# Copy to .env.mainnet.local (do not commit secrets)
# ONLY after ceremony manifest is ceremony-final|accepted

PRIVATE_KEY=0xYOUR_DEPLOYER_KEY
MAINNET_RPC=https://YOUR_MAINNET_RPC
# Repeat DeployMainnet separately with the WETH, DAI, and LUSD addresses in assets.mainnet.json.
ASSET=0x6B175474E89094C44Da98b954EedeAC495271d0F
POSEIDON=0xYOUR_POSEIDON
DEPOSIT_VERIFIER=0xYOUR_CEREMONY_DEPOSIT_ADAPTER
TRANSFER_VERIFIER=0xYOUR_CEREMONY_TRANSFER_ADAPTER
WITHDRAW_VERIFIER=0xYOUR_CEREMONY_WITHDRAW_ADAPTER
OPS_FEE_RECIPIENT=0xYOUR_TEAM_OPS_WALLET
TREE_DEPTH=20
# No MIN_WITHDRAW_DELAY: ShieldedPool has no on-chain withdrawal delay.
# Optional override path:
# CEREMONY_MANIFEST_PATH=packages/circuits/ceremony/manifest.expected.json
