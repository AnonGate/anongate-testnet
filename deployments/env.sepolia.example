# Example env for Sepolia experimental deploy
# Public configuration only. This file intentionally has no private key.

ALLOW_EXPERIMENTAL_DEPLOY=true
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_DEPLOYER_ADDRESS=0x0435d21D40dB54480EdCdbd58C2bd72C0d2122d1
OPS_FEE_RECIPIENT=0x98f28F2818de6A7120C6b1887611B14935d27e72

# Optional existing Sepolia ERC-20 contracts. Each must have runtime code.
# Omit any variable to deploy that pool's separate 18-decimal permissionless-mint test token.
# WETH_ASSET=0x...
# DAI_ASSET=0x...
# LUSD_ASSET=0x...

# Local Foundry keystore account alias; never place raw key material in this file.
FOUNDRY_ACCOUNT=sepolia-deployer
# No MIN_WITHDRAW_DELAY: ShieldedPool has no on-chain withdrawal delay.
