{
  "name": "absolute-privacy",
  "private": true,
  "version": "0.0.1",
  "description": "Non-custodial multi-asset shielded privacy pool monorepo (WETH/DAI/LUSD)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build:sdk": "npm run build --prefix packages/sdk-core",
    "build:web": "npm run build --prefix apps/web",
    "relayer": "npm start --prefix packages/relayer",
    "smoke:e2e": "npm run smoke:e2e --prefix packages/cli",
    "smoke:e2e:delay": "npm run smoke:e2e:delay --prefix packages/cli",
    "smoke:e2e:pay": "npm run smoke:e2e:pay --prefix packages/cli",
    "ceremony:hash": "node packages/circuits/scripts/hash_ceremony_artifacts.mjs",
    "ceremony:verify": "node packages/circuits/scripts/hash_ceremony_artifacts.mjs --expect packages/circuits/ceremony/manifest.expected.json",
    "ceremony:test": "node --test packages/circuits/scripts/lib/ceremony_manifest.test.mjs",
    "ceremony:checklist": "node packages/circuits/scripts/ceremony_contributor_checklist.mjs",
    "ceremony:practice": "node packages/circuits/scripts/ceremony_contribute_practice.mjs",
    "ceremony:preflight": "node packages/circuits/scripts/ceremony_preflight.mjs",
    "ceremony:status": "node packages/cli/bin/ap.mjs ceremony status",
    "ceremony:invite": "node packages/circuits/scripts/ceremony_invite_status.mjs",
    "ceremony:export-verifiers": "node packages/circuits/scripts/ceremony_export_final_verifiers.mjs",
    "ceremony:print-pins": "node packages/circuits/scripts/ceremony_export_final_verifiers.mjs --print-pins",
    "claims:lint": "node packages/cli/scripts/claims-lint.mjs",
    "drill:backup": "node packages/cli/scripts/drill-backup.mjs",
    "drill:ownership": "node packages/cli/scripts/drill-ownership.mjs",
    "drill:recipient": "node packages/cli/scripts/drill-recipient.mjs",
    "drill:view": "node packages/cli/scripts/drill-view.mjs",
    "drill:value-bound": "node packages/cli/scripts/drill-value-bound.mjs",
    "drill:incoming": "node packages/cli/scripts/drill-incoming.mjs",
    "drill:pay": "node packages/cli/scripts/drill-pay.mjs",
    "drill:payment-receipt": "node packages/cli/scripts/drill-payment-receipt.mjs",
    "gate:dev": "node packages/cli/scripts/gate-local.mjs",
    "test:vector": "npm run build --prefix packages/sdk-core && node packages/sdk-core/scripts/verify_test_vector.mjs && python packages/python-client/scripts/verify_test_vector.py",
    "test:contracts": "npm run test --prefix packages/contracts",
    "doctor": "node packages/cli/bin/ap.mjs doctor",
    "assets:list": "node packages/cli/scripts/assets-list.mjs",
    "launch:status": "node packages/cli/bin/ap.mjs launch status",
    "launch:readiness": "node packages/cli/scripts/launch-readiness.mjs",
    "launch:verify-deployment": "node packages/cli/scripts/verify-deployment.mjs",
    "test:deployment-verifier": "node --test packages/cli/test/verify-deployment.test.mjs"
  }
}
