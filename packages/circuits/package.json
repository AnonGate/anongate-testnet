{
  "name": "@absolute-privacy/circuits",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Circom circuits for Absolute Privacy",
  "scripts": {
    "compile:deposit-dev": "node ./scripts/compile_circuit.mjs deposit_dev",
    "compile:transfer-dev": "node ./scripts/compile_circuit.mjs transfer_dev",
    "compile:withdraw-dev": "node ./scripts/compile_circuit.mjs withdraw_dev",
    "compile:withdraw-1in-dev": "node ./scripts/compile_circuit.mjs withdraw_1in_dev",
    "compile:withdraw-partial-dev": "node ./scripts/compile_circuit.mjs withdraw_partial_dev",
    "compile:ownership-dev": "node ./scripts/compile_circuit.mjs ownership_dev",
    "compile:value-bound-dev": "node ./scripts/compile_circuit.mjs value_bound_dev",
    "setup:deposit-dev": "node ./scripts/setup_deposit_dev.mjs",
    "setup:ownership-dev": "node ./scripts/setup_ownership_dev.mjs",
    "setup:value-bound-dev": "node ./scripts/setup_value_bound_dev.mjs",
    "export:value-bound-dev-verifier": "node ./scripts/export_value_bound_dev_verifier.mjs",
    "export:value-bound-dev-fixture": "npm run build --prefix ../sdk-core && node ./scripts/export_value_bound_dev_fixture.mjs",
    "export:ownership-dev-verifier": "node ./scripts/export_ownership_dev_verifier.mjs",
    "export:ownership-dev-fixture": "npm run build --prefix ../sdk-core && node ./scripts/export_ownership_dev_fixture.mjs",
    "prove:ownership-dev": "npm run build --prefix ../sdk-core && node ./scripts/prove_ownership_dev.mjs",
    "verify:ownership-dev": "node ./scripts/verify_ownership_dev.mjs",
    "compile:dev": "npm run compile:deposit-dev && npm run compile:transfer-dev && npm run compile:withdraw-dev && npm run compile:withdraw-1in-dev && npm run compile:withdraw-partial-dev && npm run compile:ownership-dev && npm run compile:value-bound-dev",
    "setup:withdraw-dev": "node ./scripts/setup_withdraw_dev.mjs",
    "setup:withdraw-1in-dev": "node ./scripts/setup_withdraw_1in_dev.mjs",
    "setup:withdraw-partial-dev": "node ./scripts/setup_withdraw_partial_dev.mjs",
    "setup:transfer-dev": "node ./scripts/setup_transfer_dev.mjs",
    "prove:withdraw-dev": "npm run build --prefix ../sdk-core && node ./scripts/prove_withdraw_dev.mjs",
    "prove:withdraw-1in-dev": "npm run build --prefix ../sdk-core && node ./scripts/prove_withdraw_1in_dev.mjs",
    "prove:withdraw-partial-dev": "npm run build --prefix ../sdk-core && node ./scripts/prove_withdraw_partial_dev.mjs",
    "prove:transfer-dev": "npm run build --prefix ../sdk-core && node ./scripts/prove_transfer_dev.mjs",
    "prove:deposit-dev": "npm run build --prefix ../sdk-core && node ./scripts/prove_deposit_dev.mjs",
    "export:withdraw-fixture": "npm run build --prefix ../sdk-core && node ./scripts/export_withdraw_fixture.mjs",
    "export:transfer-fixture": "npm run build --prefix ../sdk-core && node ./scripts/export_transfer_fixture.mjs",
    "export:deposit-fixture": "npm run build --prefix ../sdk-core && node ./scripts/export_deposit_fixture.mjs",
    "compile:withdraw-1in": "node ./scripts/compile_circuit.mjs withdraw_1in",
    "compile:withdraw-partial": "node ./scripts/compile_circuit.mjs withdraw_partial",
    "setup:withdraw-1in-trusted": "node ./scripts/setup_withdraw_1in_trusted.mjs",
    "setup:withdraw-partial-trusted": "node ./scripts/setup_withdraw_partial_trusted.mjs",
    "benchmark:depth": "npm run build --prefix ../sdk-core && node ./scripts/benchmark_depth_prove.mjs",
    "compile:transfer": "node ./scripts/compile_circuit.mjs transfer",
    "compile:withdraw": "node ./scripts/compile_circuit.mjs withdraw",
    "compile:deposit": "node ./scripts/compile_circuit.mjs deposit",
    "compile:ceremony": "npm run compile:deposit && npm run compile:transfer && npm run compile:withdraw",
    "setup:deposit-trusted": "node ./scripts/setup_deposit_trusted.mjs",
    "prove:deposit-trusted": "npm run build --prefix ../sdk-core && node ./scripts/prove_deposit_trusted.mjs",
    "export:deposit-trusted-fixture": "npm run build --prefix ../sdk-core && node ./scripts/export_deposit_trusted_fixture.mjs",
    "setup:withdraw-trusted": "node ./scripts/setup_withdraw_trusted.mjs",
    "setup:transfer-trusted": "node ./scripts/setup_transfer_trusted.mjs",
    "prove:withdraw-trusted": "npm run build --prefix ../sdk-core && node ./scripts/prove_withdraw_trusted.mjs",
    "export:withdraw-trusted-fixture": "npm run build --prefix ../sdk-core && node ./scripts/export_withdraw_trusted_fixture.mjs",
    "export:transfer-trusted-fixture": "npm run build --prefix ../sdk-core && node ./scripts/export_transfer_trusted_fixture.mjs",
    "regenerate:revision-2-dev": "npm run compile:transfer-dev && npm run compile:withdraw-dev && npm run setup:transfer-dev && npm run setup:withdraw-dev && npm run export:transfer-fixture && npm run export:withdraw-fixture",
    "ceremony:start-phase2": "node ./scripts/ceremony_start_phase2.mjs",
    "ceremony:accept": "node ./scripts/ceremony_accept_contribution.mjs",
    "ceremony:verify": "node ./scripts/hash_ceremony_artifacts.mjs --expect ./ceremony/manifest.expected.json",
    "ceremony:print-pins": "node ./scripts/ceremony_export_final_verifiers.mjs --print-pins",
    "ceremony:test": "node --test ./scripts/lib/ceremony_manifest.test.mjs"
  },
  "dependencies": {
    "circomlib": "^2.0.5"
  },
  "devDependencies": {
    "circom2": "^0.2.23",
    "snarkjs": "^0.7.6"
  }
}
