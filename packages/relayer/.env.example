# Copy to packages/relayer/.env (never commit).
# Use a dedicated Sepolia hot wallet with a little ETH for gas — not your main funds.

RELAYER_PRIVATE_KEY=0xYOUR_SEPOLIA_TEST_PRIVATE_KEY
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
RELAYER_HOST=127.0.0.1
RELAYER_PORT=8787
# Optional: comma-separated origins (default allows local Vite on 5173 and 5180)
# RELAYER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5180,http://localhost:5180
